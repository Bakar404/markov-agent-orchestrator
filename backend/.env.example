# Copy to backend/.env and edit as needed.

# --- Persistence -----------------------------------------------------------
# SQLite by default. Swap for PostgreSQL, e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/markov_orchestrator
# DATABASE_URL=sqlite:///./data/orchestrator.db

# --- API -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Simulation ------------------------------------------------------------
DEFAULT_SEED=20260820
MAX_STEPS=60
BELIEF_DIM=8

# --- Reward weights --------------------------------------------------------
REWARD_W_QUALITY=1.4
REWARD_W_VERIFICATION=1.1
REWARD_W_INFO_GAIN=1.6
REWARD_W_COST=1.0
REWARD_W_LATENCY=0.6
REWARD_W_DUPLICATE=0.9
REWARD_W_PROGRESS=0.8
REWARD_W_TERMINAL=2.5

# --- Research providers ----------------------------------------------------
RESEARCH_ALLOW_NETWORK=true
RESEARCH_HTTP_TIMEOUT=12.0
SEMANTIC_SCHOLAR_API_KEY=
HITS_MCP_ENDPOINT=
HITS_MCP_API_KEY=
HITS_MCP_TOOL=research.search
